NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/celestial

# Auth secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_access_min_20_chars
JWT_REFRESH_SECRET=replace_me_refresh_min_20_chars
ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# CORS — the deployed frontend origin(s), comma-separated
CORS_ORIGIN=https://tanstack-start-app.celestial-bloom-vyuha.workers.dev

# One-time admin bootstrap (disable/rotate after first use)
ADMIN_BOOTSTRAP_EMAIL=admin@celestial.example
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace_secret
RAZORPAY_WEBHOOK_SECRET=replace_webhook_secret

# Local media uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Cart TTL (guest carts auto-expire after this many hours)
CART_TTL_HOURS=72
